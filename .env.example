# --- Environment ---
ENVIRONMENT=dev
DEBUG=true

# --- Database ---
PG_CONNECTION_STRING=postgresql://user:pass@localhost:5432/ask_my_codebase

# --- LLM ---
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# --- Retrieval tuning ---
TOP_K=5
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6

# --- Ingestion ---
REPO_ROOT_PATH=./data/repos

# --- Observability ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false